  "negative_prompt": {
    "description": "全局负面提示词",
    "type": "text",
    "default": "lowres, blurry, bad anatomy, bad hands, text, watermark, error, missing fingers, extra digit, fewer digits, cropped, worst quality, low quality, jpeg artifacts, signature, username"
  },
  "quality_toggle": {
    "description": "自动加入质量前缀",
    "type": "bool",
    "default": true
  },
  "images_per_request": {
    "description": "一次任务图片数（强制上限为 1）",
    "type": "int",
    "default": 1,
    "min": 1,
    "max": 1,
    "invisible": true
  },
  "max_api_requests_per_job": {
    "description": "429 策略 API 尝试次数上限（503 次数另计）",
    "type": "int",
    "default": 3,
    "min": 1,
    "max": 3,
    "invisible": true
  },
  "dedupe_window_seconds": {
    "description": "重复事件去重窗口（秒）",
    "type": "int",
    "default": 30,
    "min": 1,
    "max": 300
  },
  "queue_timeout": {
    "description": "排队超时（秒）",
    "type": "int",
    "default": 120,
    "min": 1,
    "max": 600
  },
  "retry_mode": {
    "description": "429 限流重试策略",
    "type": "string",
    "default": "none",
    "options": [
      "none",
      "rate_limit_once",
      "rate_limit_twice"
    ],
    "labels": {
      "none": "不自动重试（最严格）",
      "rate_limit_once": "仅 429 自动重试 1 次",
      "rate_limit_twice": "仅 429 自动重试 2 次"
    },
    "hint": "此选项只控制 429。503 使用独立次数配置；网络超时和连接中断不自动重试。"
  },
  "retry_503_count": {
    "description": "图片服务 HTTP 503 自动重试次数", "type": "int", "default": 0, "min": 0, "max": 3,
    "hint": "0 关闭，最多额外重试 3 次。只对图片服务明确返回的 HTTP 503 生效，不重新调用绘图 LLM。使用重试基础等待与 Retry-After；服务端若已生成图片，重发可能重复计费。"
  },
  "retry_delay": {
    "description": "429 / 503 重试基础等待（秒）",
    "type": "float",
    "default": 5,
    "min": 1,
    "max": 300,
    "hint": "若服务返回 Retry-After，则使用两者中较长的等待时间。"
  },
  "error_notify_mode": {
    "description": "错误提示",
    "type": "string",
    "default": "final_only",
    "options": [
      "silent",
      "final_only",
      "admin_only"
    ],
    "labels": {
      "silent": "静默，仅日志",
      "final_only": "发送最终结果",
      "admin_only": "仅管理员可见"
    }
  },
  "show_queue_notice": {
    "description": "发送排队提示",
    "type": "bool",
    "default": true
  },
  "show_retry_notice": {
    "description": "发送 429 重试提示",
    "type": "bool",
    "default": false,
    "hint": "开启后会在真正执行下一次 429 重试前向会话发送提示。"
  },
  "auto_clean_delay": {
    "description": "临时图片清理延迟（秒）",
    "type": "int",
    "default": 300,
    "min": 0,
    "max": 86400
  },
  "default_preset_id": {
    "description": "默认自身人设角色卡 ID",
    "type": "string",
    "default": "",
    "hint": "画 AI 自己时，人设映射未命中则使用此卡；画其他角色或风景不会自动套用。固定命令使用 /nai self 应用此卡。"
  },
  "persona_preset_map": {
    "description": "AstrBot 自身人设到绘画角色卡的映射",
    "type": "dict",
    "default": {},
    "invisible": true
  },
  "llm_card_mode": {
    "description": "LLM 角色卡使用方式",
    "type": "string",
    "default": "context",
    "options": ["context", "strict"],
    "hint": "context：身份、默认完整服饰、画风分层保存。主模型用 outfit 整体替换服饰，默认仅本图；剧情实际换装才 state_scope=story。剧情服饰须由当前聊天历史验证，清空或切换对话后失效。strict：保留旧版过滤和本轮覆盖，仅在 prompt 描述修改。只影响普通 LLM 生图。"
  },
  "llm_auto_reference": {
    "description": "LLM 自动应用角色卡绑定参考图",
    "type": "bool",
    "default": true,
    "hint": "仅单个明确选中的绘画角色可使用该卡参考图；剧情锚点模式需主模型确认符合当前外观并设置 use_reference=true，避免参考图还原旧衣服。无卡和多人图不自动套用。"
  },
  "img2img_enabled": {
    "description": "启用图生图",
    "type": "bool",
    "default": true
  },
  "reference_enabled": {
    "description": "启用参考图 / Precise Reference",
