{
  "config_version": {
    "type": "int",
    "default": 7,
    "invisible": true
  },
  "provider": {
    "description": "生图后端",
    "type": "string",
    "default": "novelai_official",
    "options": [
      "novelai_official",
      "openai_compatible"
    ],
    "hint": "官方 NovelAI 或 OpenAI / NewAPI 兼容模式。",
    "labels": {
      "novelai_official": "NovelAI 官方",
      "openai_compatible": "OpenAI / NewAPI 兼容"
    }
  },
  "drawing_llm_provider_id": {
    "description": "独立绘图 LLM Provider ID（留空关闭）",
    "type": "string",
    "default": "",
    "hint": "仅 n 暗号和 /n 使用此模型。n 在主模型完整回复发送后规划，/n 只出图。普通绘图工具始终由主模型直接写参数出图，配置此项不会自动转述。"
  },
  "drawing_trigger": {
    "description": "图文双线暗号（留空关闭）", "type": "string", "default": "n",
    "hint": "放在消息首尾或单独发送，触发主模型正常回复和独立绘图，不依赖主模型传 Tag。可与中文相连，英文单词中的 n 不触发；最多 16 字符。"
  },
  "drawing_llm_output_mode": {
    "description": "绘图 LLM 输出协议", "type": "string", "default": "auto",
    "options": ["auto", "tool", "json"],
    "labels": {"auto": "自动（OpenAI 兼容优先参数工具）", "tool": "绘图参数工具", "json": "JSON 文本"},
    "hint": "工具模式从首次请求即要求原生参数提交（tool_choice=required），card 必须带角色卡 ID。不支持时可手动选 JSON：发送 json_object，并附同源字段结构及示例，插件校验人物对象和只读素材。格式纠错最多一次，不静默切换协议重发。"
  },
  "drawing_llm_format_retry": {
    "description": "格式或字段错误时纠正一次", "type": "bool", "default": true,
    "hint": "先清理可识别的工具包装和冗余默认字段；仍无效且总超时预算剩余至少 3 秒时，反馈错误纠正一次。验证前不请求图片服务，拒绝/网络失败不重试。"
  },
  "drawing_llm_transport": {
    "description": "绘图 LLM 调用方式", "type": "string", "default": "auto",
    "options": ["auto", "stream", "nonstream"],
    "labels": {"auto": "自动（跟随主聊天流式设置）", "stream": "流式", "nonstream": "非流式"},
    "hint": "n 和 /n 共用。自动模式跟随主聊天的流式设置；取不到设置时 OpenAI 兼容接口使用流式。完整参数通过校验后才出图，失败不自动切换重发。"
  },
  "drawing_llm_reasoning_effort": {
    "description": "绘图 LLM 推理强度", "type": "string", "default": "inherit",
    "options": ["inherit", "low", "medium", "high"],
    "labels": {"inherit": "继承 Provider", "low": "低", "medium": "中", "high": "高"},
    "hint": "仅 OpenAI 兼容接口。仅覆盖本次绘图请求的 reasoning_effort，不影响主聊天；需上游支持。不支持时选继承，错误不会静默重发。"
  },
  "drawing_llm_max_tokens": {
    "description": "绘图 LLM 输出 Token 预算", "type": "int", "default": 0, "min": 0, "max": 16384,
    "hint": "0 继承 Provider。非 0 仅对绘图请求设置 max_completion_tokens（可能含隐藏推理），需上游支持；预算耗尽会明确报截断，不用残缺方案生图。"
  },
  "drawing_llm_debug": {
    "description": "记录绘图 LLM 回包预览", "type": "bool", "default": false,
    "hint": "排查时开启，在日志与请求快照显示最多 2000 字符的绘图返回内容，可能包含画面描述。默认记录分阶段耗时、Provider、请求大小、图片来源和上游提供的 Token 用量，不记录正文。"
  },
  "drawing_llm_context_messages": {
    "description": "旧文本模式的最近对话消息数",
    "type": "int",
    "default": 12,
    "hint": "仅旧文本模式使用：0-30 条 user/assistant 消息，每条最多 2000 字符；0 不读取旧对话。共享模式按主会话窗口和字符上限取原生消息，不使用此值。"
  },
  "drawing_llm_context_mode": {
    "description": "绘图上下文来源", "type": "string", "default": "shared",
    "options": ["shared", "legacy"],
    "labels": {"shared": "共享主会话（推荐）", "legacy": "旧版最近 N 条文本"},
    "hint": "共享模式：n 使用本轮主 Agent 快照；/n 读取当前会话并使用 AstrBot 同源人设与技能解析。保留原生对话和完整工具记录，不切换聊天模型。"
  },
  "drawing_llm_context_chars": {
    "description": "共享绘图上下文字符上限", "type": "int", "default": 48000,
    "min": 4096, "max": 128000,
    "hint": "4096-128000 字符。包含人设、原生历史和本轮绘图材料；超过时按完整轮次裁去最旧历史，不拆开工具调用与结果。人设和最新一轮仍超限会明确报错。"
  },
  "drawing_llm_timeout": {
    "description": "绘图 LLM 总超时预算（秒）",
    "type": "int",
    "default": 60,
    "hint": "5-180 秒，首次规划和一次格式纠正共同使用此预算；重试仅使用剩余时间，不再追加一个完整超时。等待主模型回复和图片服务时间另计。"
  },
  "drawing_llm_use_images": {
    "description": "允许绘图 LLM 读取本轮附图与上一张成图",
    "type": "bool",
    "default": false,
    "hint": "需要视觉 LLM。最多两张当前附图；仅明确改图、保留或延续画面时附带有效的上一张成图，普通新图只传上次方案文字，减少视觉请求开销。仅作理解参考，不自动成为图生图底图。成图保留最多 30 分钟，重置对话后失效。"
  },
  "drawing_llm_prompt": {
    "description": "独立绘图 LLM 的附加偏好",
    "type": "text",
    "default": "",
    "hint": "可填写构图、Tag 组织和连续性偏好，最多 4000 字符。内置专用绘图技能会自动加载。"
  },
  "api_token": {
    "description": "NovelAI Persistent Token",
    "type": "string",
    "default": "",
    "secret": true,
    "obvious_hint": true,
    "hint": "仅官方模式使用；不会在页面回显。"
  },
  "api_key": {
    "description": "OpenAI / NewAPI API Key",
    "type": "string",
    "default": "",
    "secret": true,
    "obvious_hint": true,
    "hint": "仅兼容模式使用；不会在页面回显。"
  },
