{
  "config_version": {
    "type": "int",
    "default": 6,
    "invisible": true
  },
  "provider": {
    "description": "生图后端",
    "type": "string",
    "default": "novelai_official",
    "options": [
      "novelai_official",
      "openai_compatible"
    ],
    "hint": "官方 NovelAI 或 OpenAI / NewAPI 兼容模式。",
    "labels": {
      "novelai_official": "NovelAI 官方",
      "openai_compatible": "OpenAI / NewAPI 兼容"
    }
  },
  "api_token": {
    "description": "NovelAI Persistent Token",
    "type": "string",
    "default": "",
    "secret": true,
    "obvious_hint": true,
    "hint": "仅官方模式使用；不会在页面回显。"
  },
  "api_key": {
    "description": "OpenAI / NewAPI API Key",
    "type": "string",
    "default": "",
    "secret": true,
    "obvious_hint": true,
    "hint": "仅兼容模式使用；不会在页面回显。"
  },
  "base_url": {
    "description": "NovelAI 官方 Base URL",
    "type": "string",
    "default": "https://image.novelai.net"
  },
  "openai_base_url": {
    "description": "OpenAI / NewAPI Base URL",
    "type": "string",
    "default": ""
  },
  "openai_image_endpoint": {
    "description": "兼容模式文生图端点",
    "type": "string",
    "default": "/v1/images/generations"
  },
  "openai_edit_endpoint": {
    "description": "兼容模式图生图端点",
    "type": "string",
    "default": "/v1/images/edits"
  },
  "openai_auth_header": {
    "description": "兼容后端鉴权请求头",
    "type": "string",
    "default": "Authorization",
    "options": [
      "Authorization",
      "x-api-key"
    ],
    "labels": {
      "Authorization": "Authorization",
      "x-api-key": "x-api-key"
    }
  },
  "openai_auth_prefix": {
    "description": "兼容后端鉴权前缀",
    "type": "string",
    "default": "Bearer",
    "hint": "Authorization 通常填写 Bearer；x-api-key 通常留空。"
  },
  "model": {
    "description": "模型 ID",
    "type": "string",
    "default": "nai-diffusion-5-full",
    "options": [
      "nai-diffusion-5-full",
      "nai-diffusion-5-curated",
      "nai-diffusion-4-5-full",
      "nai-diffusion-4-5-curated",
      "nai-diffusion-4-full",
      "nai-diffusion-4-curated-preview",
      "nai-diffusion-3",
      "nai-diffusion-furry-3",
      "custom"
    ],
    "labels": {
      "nai-diffusion-5-full": "V5 Full",
      "nai-diffusion-5-curated": "V5 Curated",
      "nai-diffusion-4-5-full": "V4.5 Full",
      "nai-diffusion-4-5-curated": "V4.5 Curated",
      "nai-diffusion-4-full": "V4 Full",
      "nai-diffusion-4-curated-preview": "V4 Curated Preview",
      "nai-diffusion-3": "V3 Anime",
      "nai-diffusion-furry-3": "V3 Furry",
      "custom": "自定义模型 ID"
    }
  },
  "custom_model": {
    "description": "自定义模型 ID",
    "type": "string",
    "default": ""
  },
  "command_prefix": {
    "description": "固定命令名",
    "type": "string",
    "default": "nai",
    "hint": "只填写命令名，不含斜杠。默认使用 /nai。"
  },
  "invoke_mode": {
    "description": "入口模式",
    "type": "string",
    "default": "command_only",
    "options": [
      "disabled",
      "command_only",
      "llm_tool_only",
      "both"
    ],
    "labels": {
      "disabled": "全部禁用",
      "command_only": "仅固定命令",
      "llm_tool_only": "仅 LLM 工具",
      "both": "命令 + LLM 工具"
    }
  },
  "private_access": {
    "description": "私聊权限",
    "type": "string",
    "default": "all",
    "options": [
      "all",
      "admin_only",
      "allowlist",
      "disabled"
    ],
    "labels": {
      "all": "所有人",
      "admin_only": "仅管理员",
      "allowlist": "白名单",
      "disabled": "禁用"
    }
  },
  "group_access": {
    "description": "群聊权限",
    "type": "string",
    "default": "admin_only",
    "options": [
      "admin_only",
      "all",
      "allowlist",
      "disabled"
    ],
    "labels": {
      "admin_only": "仅管理员",
      "all": "所有成员",
      "allowlist": "白名单",
      "disabled": "禁用"
    }
  },
  "allowed_users": {
    "description": "用户白名单",
    "type": "list",
    "default": [],
    "items": {
      "type": "string"
    }
  },
  "allowed_groups": {
    "description": "群聊白名单",
    "type": "list",
    "default": [],
    "items": {
      "type": "string"
    }
  },
  "admin_bypass": {
    "description": "管理员绕过白名单",
    "type": "bool",
    "default": true
  },
  "legacy_command_enabled": {
    "description": "兼容 /nai <描述>",
    "type": "bool",
    "default": true
  },
  "width": {
    "description": "默认宽度",
    "type": "int",
    "default": 832,
    "min": 64,
    "max": 2048
  },
  "height": {
    "description": "默认高度",
    "type": "int",
    "default": 1216,
    "min": 64,
    "max": 2048
  },
  "steps": {
    "description": "采样步数",
    "type": "int",
    "default": 28,
    "min": 1,
    "max": 50
  },
  "scale": {
    "description": "提示词引导强度",
    "type": "float",
    "default": 5,
    "min": 1,
    "max": 20
  },
  "sampler": {
    "description": "采样器",
    "type": "string",
    "default": "k_euler_ancestral",
    "options": [
      "k_euler_ancestral",
      "k_euler",
      "k_dpmpp_2s_ancestral",
      "k_dpmpp_2m",
      "k_dpmpp_sde"
    ]
  },
  "negative_prompt": {
    "description": "全局负面提示词",
    "type": "text",
    "default": "lowres, blurry, bad anatomy, bad hands, text, watermark, error, missing fingers, extra digit, fewer digits, cropped, worst quality, low quality, jpeg artifacts, signature, username"
  },
  "quality_toggle": {
    "description": "自动加入质量前缀",
    "type": "bool",
    "default": true
  },
  "images_per_request": {
    "description": "一次任务图片数（强制上限为 1）",
    "type": "int",
    "default": 1,
    "min": 1,
    "max": 1,
    "invisible": true
  },
  "max_api_requests_per_job": {
    "description": "一次任务 API 尝试次数硬上限（仅 429 策略可超过 1）",
    "type": "int",
    "default": 3,
    "min": 1,
    "max": 3,
    "invisible": true
  },
  "dedupe_window_seconds": {
    "description": "重复事件去重窗口（秒）",
    "type": "int",
    "default": 30,
    "min": 1,
    "max": 300
  },
  "queue_timeout": {
    "description": "排队超时（秒）",
    "type": "int",
    "default": 120,
    "min": 1,
    "max": 600
  },
  "retry_mode": {
    "description": "429 限流重试策略",
    "type": "string",
    "default": "none",
    "options": [
      "none",
      "rate_limit_once",
      "rate_limit_twice"
    ],
    "labels": {
      "none": "不自动重试（最严格）",
      "rate_limit_once": "仅 429 自动重试 1 次",
      "rate_limit_twice": "仅 429 自动重试 2 次"
    },
    "hint": "只在服务明确返回 429 时重试；网络超时、连接中断和其他错误不会重试，以避免重复扣费或重复生图。"
  },
  "retry_delay": {
    "description": "429 重试基础等待（秒）",
    "type": "float",
    "default": 5,
    "min": 1,
    "max": 300,
    "hint": "若服务返回 Retry-After，则使用两者中较长的等待时间。"
  },
  "error_notify_mode": {
    "description": "错误提示",
    "type": "string",
    "default": "final_only",
    "options": [
      "silent",
      "final_only",
      "admin_only"
    ],
    "labels": {
      "silent": "静默，仅日志",
      "final_only": "发送最终结果",
      "admin_only": "仅管理员可见"
    }
  },
  "show_queue_notice": {
    "description": "发送排队提示",
    "type": "bool",
    "default": true
  },
  "show_retry_notice": {
    "description": "发送 429 重试提示",
    "type": "bool",
    "default": false,
    "hint": "开启后会在真正执行下一次 429 重试前向会话发送提示。"
  },
  "auto_clean_delay": {
    "description": "临时图片清理延迟（秒）",
    "type": "int",
    "default": 300,
    "min": 0,
    "max": 86400
  },
  "default_preset_id": {
    "description": "默认角色卡 ID",
    "type": "string",
    "default": ""
  },
  "persona_preset_map": {
    "description": "AstrBot 人设到角色卡的映射",
    "type": "dict",
    "default": {},
    "invisible": true
  },
  "llm_auto_reference": {
    "description": "LLM 自动应用角色卡绑定参考图",
    "type": "bool",
    "default": true,
    "hint": "启用后，LLM 生图会自动使用当前人设角色卡绑定的参考图；NovelAI 官方使用 Precise Reference，兼容后端使用图生图。"
  },
  "img2img_enabled": {
    "description": "启用图生图",
    "type": "bool",
    "default": true
  },
  "reference_enabled": {
    "description": "启用参考图 / Precise Reference",
    "type": "bool",
    "default": true
  },
  "img2img_strength": {
    "description": "图生图强度",
    "type": "float",
    "default": 0.7,
    "min": 0,
    "max": 1
  },
  "img2img_noise": {
    "description": "图生图噪声",
    "type": "float",
    "default": 0.1,
    "min": 0,
    "max": 1
  },
  "img2img_color_correct": {
    "description": "图生图颜色校正",
    "type": "bool",
    "default": true
  },
  "reference_strength": {
    "description": "Precise Reference Strength",
    "type": "float",
    "default": 0.6,
    "min": 0,
    "max": 1
  },
  "reference_fidelity": {
    "description": "Precise Reference Fidelity",
    "type": "float",
    "default": 0.6,
    "min": 0,
    "max": 1
  },
  "reference_information_extracted": {
    "description": "参考图信息提取程度",
    "type": "float",
    "default": 1,
    "min": 0,
    "max": 1
  },
  "notify_429": {
    "description": "429 频率限制提示",
    "type": "bool",
    "default": true,
    "hint": "关闭后仅记录日志，不向用户发送 429 提示。"
  },
  "sticker_enabled": {
    "description": "表情包模式总开关",
    "type": "bool",
    "default": false,
    "hint": "启用后，LLM 回复完成时会按概率判断是否生成情绪表情包。"
  },
  "sticker_probability": {
    "description": "表情包概率（百分比）",
    "type": "float",
    "default": 20,
    "min": 0,
    "max": 100
  },
  "sticker_send_mode": {
    "description": "表情包发送方式",
    "type": "string",
    "default": "after_reply",
    "options": ["after_reply", "same_bubble"],
    "labels": {
      "after_reply": "文字回复后发送",
      "same_bubble": "与文字同一气泡"
    }
  },
  "sticker_cooldown_seconds": {
    "description": "表情包冷却时间（秒）",
    "type": "int",
    "default": 60,
    "min": 0,
    "max": 86400
  },
  "sticker_context_messages": {
    "description": "表情包判断上下文条数",
    "type": "int",
    "default": 8,
    "min": 1,
    "max": 20
  },
  "sticker_llm_provider_id": {
    "description": "表情包判断模型 ID",
    "type": "string",
    "default": "",
    "hint": "留空跟随当前聊天模型。"
  },
  "sticker_llm_timeout": {
    "description": "表情包判断超时（秒）",
    "type": "int",
    "default": 45,
    "min": 5,
    "max": 180
  },
  "sticker_width": {
    "description": "表情包宽度",
    "type": "int",
    "default": 512,
    "min": 64,
    "max": 2048
  },
  "sticker_height": {
    "description": "表情包高度",
    "type": "int",
    "default": 512,
    "min": 64,
    "max": 2048
  },
  "sticker_auto_reference": {
    "description": "表情包自动使用专用角色卡参考图",
    "type": "bool",
    "default": true
  },
  "sticker_emotion_tool": {
    "description": "允许 LLM 提供情绪标签",
    "type": "bool",
    "default": true
  },
  "sticker_prompt": {
    "description": "表情包通用提示词",
    "type": "string",
    "default": "chibi, reaction sticker, expressive face, upper body, simple background, white background, no text"
  },
  "sticker_decision_prompt": {
    "description": "表情包判断规则",
    "type": "string",
    "default": "根据对话语境和回复情绪选择合适的表情，也可使用嘲笑、无奈、得意、委屈、震惊、吐槽等特殊表情。严肃或不适合插入表情包的场合不发送。"
  },
  "sticker_role_card": {
    "description": "表情包专用角色卡",
    "type": "dict",
    "default": {
      "name": "表情包角色卡",
      "positive_prompt": "",
      "negative_prompt": "",
      "lock_positive": true,
      "positive_strength": 1.35,
      "quality_override": "off",
      "reference_id": "",
      "reference_type": "character"
    },
    "invisible": true
  }
}
